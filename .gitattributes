# Repository line-ending policy.
# The repo standard is CRLF (see .editorconfig: end_of_line = crlf) so that
# `dotnet format --verify-no-changes` produces identical results on Windows,
# Linux, and macOS CI runners. Text files are normalized to CRLF in the working
# tree; binaries are left untouched.

# Default: treat as text, normalize, check out with CRLF.
* text=auto eol=crlf

# Explicit text types (belt-and-suspenders for common source/config files).
*.cs        text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.sln       text eol=crlf
*.json      text eol=crlf
*.md        text eol=crlf
*.yml       text eol=crlf
*.yaml      text eol=crlf
*.editorconfig text eol=crlf

# Shell scripts run on Linux hosts (e.g. the Hyperlight VM); they MUST stay LF
# or bash fails with "$'\r': command not found".
*.sh        text eol=lf

# Binary assets: never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.dll   binary
*.exe   binary
*.pdb   binary
*.wasm  binary
