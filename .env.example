# Sterling Vale CodeAct — example environment configuration.
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# Prefer DefaultAzureCredential (identity) over API keys where possible.
# This file is not automatically loaded. Benchmark defaults to --model fake even with Azure set.
# APIs default to fake; explicitly opt in with --model live or MODEL_MODE=live.
# Current Responses cohorts should use scripts/vm/run-v3-profile.py --cohort NAME:
# it defaults to configs/v3-reference.json and supplies verified cache/context pricing,
# pinned model/version, reasoning, API and execution policy. The generic defaults below
# are for the offline demo / historical Chat Completions, NOT the enforced live cohort.
MODEL_MODE=fake

# --- Azure OpenAI (required only for LiveModel tests / real runs) ---
# A pasted /openai/v1 path is normalized to this base URL with a notice.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
# Required for Responses deployment metadata verification; never commit a real value.
AZURE_OPENAI_RESOURCE_ID=
# Runner-owned for current cohorts; only set manually for an explicit new experiment.
MODEL_API_MODE=chat-completions
AZURE_OPENAI_MODEL_NAME=
AZURE_OPENAI_MODEL_VERSION=
MODEL_DEFAULT_REASONING_EFFORT=not-supported
# Only set if identity-based auth is not available:
# AZURE_OPENAI_API_KEY=

# --- Hyperlight runtime (required for real Python execution, not live code generation) ---
# Absolute path to the Python (or WASM) guest module.
HYPERLIGHT_PYTHON_GUEST_PATH=

# --- Benchmark limits ---
BENCHMARK_TIMEOUT_SECONDS=120
BENCHMARK_MAX_TURNS=12

# --- Pricing (USD per 1,000,000 tokens) for cost estimation ---
# Verified against Azure Retail Prices API for gpt-4o 2024-11-20,
# GlobalStandard, East US. Meters: gpt 4o 1120 Inp glbl / Outp glbl Tokens.
# API units: $0.0025 / $0.01 per 1K tokens, multiplied by 1000 below.
# Estimate only: all input at uncached retail rate; excludes cache discounts,
# negotiated rates, unreported usage and VM/infrastructure charges. Not an invoice.
PRICING_INPUT_PER_MILLION=2.50
PRICING_OUTPUT_PER_MILLION=10.00
PRICING_SOURCE_URL="https://prices.azure.com/api/retail/prices?%24filter=productName%20eq%20%27Azure%20OpenAI%27%20and%20armRegionName%20eq%20%27eastus%27%20and%20contains(meterName,%27gpt%204o%201120%27)"
PRICING_VERIFIED_ON=2026-11-16
PRICING_BASIS="USD retail estimate; gpt-4o 2024-11-20; GlobalStandard; eastus; uncached input"

# --- Telemetry ---
# Live generated Python is saved independently of payload mode, subject to redaction/size bounds.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Test opt-ins (default: disabled) ---
ENABLE_LIVE_TESTS=false
