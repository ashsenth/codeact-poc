# Sterling Vale CodeAct — example environment configuration.
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# Prefer DefaultAzureCredential (identity) over API keys where possible.

# --- Azure OpenAI (required only for LiveModel tests / real runs) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
# Only set if identity-based auth is not available:
# AZURE_OPENAI_API_KEY=

# --- Hyperlight CodeAct runtime (required only for Hyperlight tests / CodeAct app) ---
# Absolute path to the Python (or WASM) guest module.
HYPERLIGHT_PYTHON_GUEST_PATH=

# --- Benchmark limits ---
BENCHMARK_TIMEOUT_SECONDS=120
BENCHMARK_MAX_TURNS=12

# --- Pricing (USD per 1,000,000 tokens) for cost estimation ---
PRICING_INPUT_PER_MILLION=2.50
PRICING_OUTPUT_PER_MILLION=10.00

# --- Telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Test opt-ins (default: disabled) ---
ENABLE_LIVE_TESTS=false
