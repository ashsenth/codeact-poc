# Sterling Vale CodeAct — example environment configuration.
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# Prefer DefaultAzureCredential (identity) over API keys where possible.
# This file is not automatically loaded. Benchmark defaults to --model fake even with Azure set.
# APIs default to fake; explicitly opt in with --model live or MODEL_MODE=live.
MODEL_MODE=fake

# --- Azure OpenAI (required only for LiveModel tests / real runs) ---
# A pasted /openai/v1 path is normalized to this base URL with a notice.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
# Only set if identity-based auth is not available:
# AZURE_OPENAI_API_KEY=

# --- Hyperlight runtime (required for real Python execution, not live code generation) ---
# Absolute path to the Python (or WASM) guest module.
HYPERLIGHT_PYTHON_GUEST_PATH=

# --- Benchmark limits ---
BENCHMARK_TIMEOUT_SECONDS=120
BENCHMARK_MAX_TURNS=12

# --- Pricing (USD per 1,000,000 tokens) for cost estimation ---
PRICING_INPUT_PER_MILLION=2.50
PRICING_OUTPUT_PER_MILLION=10.00

# --- Telemetry ---
# Live generated Python is saved independently of payload mode, subject to redaction/size bounds.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Test opt-ins (default: disabled) ---
ENABLE_LIVE_TESTS=false
